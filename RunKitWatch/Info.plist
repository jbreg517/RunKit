<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>RunKit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Marks this as a modern single-target watchOS app. The old two-target
	     WatchKit-extension layout (WKWatchKitApp) is gone as of watchOS 9. -->
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.ferrixguild.runkit</string>
	<!-- Without workout-processing the app is suspended the moment the wrist drops,
	     which stops the card engine, the interval timer and the haptics mid-run. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
		<string>location</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>RunKit reads your heart rate, distance and energy while you record a walk, run or ride, so it can show live metrics and hold you to a heart-rate zone. This stays on your device.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>RunKit saves the walks, runs and rides you record on your watch to Apple Health, including route, distance and active energy.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>RunKit uses your location only while you’re recording a walk, run or ride, to map your route. Routes stay on your device.</string>
</dict>
</plist>
